#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
validator="$repo_root/board-games/scripts/validate_games.py"
games="$repo_root/board-games/games.json"

if command -v python >/dev/null 2>&1; then
  python "$validator" "$games"
elif command -v python3 >/dev/null 2>&1; then
  python3 "$validator" "$games"
else
  echo "Python is required to validate board-games/games.json before pushing." >&2
  exit 1
fi
